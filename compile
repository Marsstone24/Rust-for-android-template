#!/usr/bin/env bash
# generated by install.sh
set -euo pipefail
cd "$(dirname "$0")"

export ANDROID_HOME="${ANDROID_HOME:-/home/marsstone/Android/Sdk}"
export ANDROID_NDK_HOME="${ANDROID_NDK_HOME:-/home/marsstone/Android/Sdk/ndk/28.2.13676358}"
NDK_TARGETS=(-t arm64-v8a )

DEBUG=false
RELEASE=false

help() {
  cat <<'HELP'

USAGE:
  ./compile [options]

Options (short flags can be combined, e.g. -rd):
  -h | --help      show this list
  -d | --debug     compile debug apk (default)
  -r | --release   compile release apk

HELP
}

# translate long options to short ones so getopts can handle everything
ARGS=()
for arg in "$@"; do
  case "$arg" in
    --help)    ARGS+=("-h") ;;
    --debug)   ARGS+=("-d") ;;
    --release) ARGS+=("-r") ;;
    *)         ARGS+=("$arg") ;;
  esac
done

if [ ${#ARGS[@]} -eq 0 ]; then
  printf "\nNo arguments, compiling debug apk as default.\n"
  printf "Look up -h or --help to see options.\n\n"
  sleep 4
  ARGS+=("-d")
fi

set -- "${ARGS[@]}"

while getopts "hdr" opt; do
  case "$opt" in
    h) help; exit 0 ;;
    d) DEBUG=true ;;
    r) RELEASE=true ;;
    *) echo "Invalid option given, see help with -h or --help" >&2; exit 1 ;;
  esac
done

if $DEBUG; then
  cargo ndk "${NDK_TARGETS[@]}" -o android/app/src/debug/jniLibs build
  (cd android && ./gradlew assembleDebug)
  echo "Debug APK:   android/app/build/outputs/apk/debug/app-debug.apk"
fi
if $RELEASE; then
  cargo ndk "${NDK_TARGETS[@]}" -o android/app/src/release/jniLibs build --release
  (cd android && ./gradlew assembleRelease)
  echo "Release APK: android/app/build/outputs/apk/release/app-release.apk"
fi
